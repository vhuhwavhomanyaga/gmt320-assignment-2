
:root {
  --ink: #16231f;
  --paper: #f5f3ee;
  --panel: #ffffff;
  --green: #4d0b5d;
  --ochre: #1b55c9;
  --line: #cad9d8;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: system-ui, "Segoe UI", sans-serif; line-height: 1.5; }

.site-header { background: var(--green); color: #fff; padding: 1.5rem clamp(1rem, 4vw, 3rem); }
.site-header h1 { margin: 0 0 .25rem; font-family: Georgia, "Times New Roman", serif; font-size: clamp(1.6rem, 4vw, 2.4rem); }
.site-header p { margin: 0; max-width: 62ch; opacity: .9; }

.controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: end; padding: 1rem clamp(1rem, 4vw, 3rem); background: #fff; border-bottom: 2px solid var(--ochre); }
.controls label { display: flex; flex-direction: column; font-size: .85rem; font-weight: 600; gap: .25rem; }
select, button { font: inherit; padding: .45rem .7rem; border: 1px solid var(--ink); border-radius: 4px; background: #fff; color: var(--ink); }
button { background: var(--ink); color: #fff; cursor: pointer; }
select:focus-visible, button:focus-visible { outline: 3px solid var(--ochre); outline-offset: 2px; }

.dashboard { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; padding: 1.5rem clamp(1rem, 4vw, 3rem); }
#status { grid-column: 1 / -1; margin: 0; }
#status:empty, #status[hidden] { display: none; }
.indicators { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
.indicator { background: var(--panel); border-left: 6px solid var(--ochre); padding: 1rem 1.25rem; }
.indicator h2 { margin: 0; font-size: 1rem; }
.indicator .value { margin: .2rem 0; font-family: Georgia, serif; font-size: clamp(2rem, 5vw, 3rem); color: var(--green); }
.indicator small { color: #555; }

.panel { background: var(--panel); border: 1px solid var(--line); padding: 1rem; min-width: 0; }
.panel.wide { grid-column: 1 / -1; }
.chart-box { position: relative; height: 320px; } 
.site-footer { padding: 1rem clamp(1rem, 4vw, 3rem); font-size: .85rem; color: #555; }

/* Stacking everything on smaller screens */
@media (max-width: 760px) {
  .dashboard, .indicators { grid-template-columns: 1fr; }
  .controls label, select, button { width: 100%; }
  .chart-box { height: 280px; }
}